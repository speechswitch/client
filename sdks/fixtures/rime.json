    {"wire": "{\"type\":\"timestamps\",\"contextId\":null,\"word_timestamps\":{\"words\":[\"hi\"],\"start\":[true],\"end\":[1]}}", "error": "Invalid Rime timestamp interval"},
    {"wire": "{\"type\":\"timestamps\",\"contextId\":null,\"word_timestamps\":{\"words\":[\"hi\"],\"start\":[1],\"end\":[0]}}", "error": "Invalid Rime timestamp interval"},
    {"wire": "{\"type\":\"timestamps\",\"contextId\":null,\"word_timestamps\":{\"words\":[\"hi\"],\"start\":[0],\"end\":[1e308]}}", "error": "Invalid Rime timestamp interval"}
